# hearrt-devops Unified Environment Variables Template
# ----------------------------------------------------
# 1. GitHub Packages Configuration
# Used by docker-compose.yml to pull the correct images
GITHUB_USERNAME=your_github_username
BACKEND_VERSION=v1.0.0
AI_VERSION=v1.0.0

# ----------------------------------------------------
# 2. Database Configuration
# These must match exactly for the PostgreSQL container
POSTGRES_USER=hearrt_app
POSTGRES_PASSWORD=secure_db_password
POSTGRES_DB=hearrt
# Application connection string (points to the postgres container inside Docker network)
DATABASE_URL=postgres://hearrt_app:secure_db_password@postgres:5432/hearrt

# ----------------------------------------------------
# 3. Application Secrets (Backend & AI)
# These will be dynamically injected by GitHub Actions Secrets during deployment

# -- Backend Secrets --
NODE_ENV=production
JWT_SECRET=your_jwt_secret
REFRESH_TOKEN_SECRET=your_refresh_secret
ADMIN_JWT_SECRET=your_admin_secret
CONTENT_ENCRYPTION_KEY=your_base64_32_byte_key
ADMIN_GOOGLE_CLIENT_ID=your_admin_google_id
GOOGLE_CLIENT_ID=your_google_id

# -- Backend External Services --
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
EMAIL_USER=you@yourdomain.com
EMAIL_PASS=your-mailbox-password
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key

# -- AI & ML Secrets --
OPENAI_API_KEY=your_openai_key
OPENAI_AVATAR_API_KEY=your_openai_avatar_key
OPENAI_SUMMARY_API_KEY=your_openai_summary_key
GEMINI_API_KEY=your_gemini_key

APP_ENV=production
LOG_LEVEL=INFO
